{
  "permissions": {
    "deny": ["Read(./.env)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/trava.mjs" }
        ]
      }
    ]
  }
}
